{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@cutout/jsx"
  },
  "tasks": {
    "bundle": "deno run --unstable-bundle --allow-write --allow-read ./scripts/bundle.jsx",
    "clean": "rm -rf .output",
    "open": "open .output/index.html"
  },
  "imports": {
    "@cutout/jsx": "jsr:@cutout/jsx",
    "@cutout/store": "jsr:@cutout/store",
    "@std/fmt": "jsr:@std/fmt",
    "roadroller": "npm:roadroller",
    "brotli": "npm:brotli",
    "~projections/": "./libraries/projections/"
  }
}
