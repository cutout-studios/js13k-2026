{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@cutout/jsx"
  },
  "tasks": {
    "setup": "brew bundle",
    "bundle": "deno run --unstable-bundle --allow-write --allow-read --allow-run ./scripts/bundle.jsx",
    "clean": "rm -rf .output",
    "open": "open .output/index.html"
  },
  "imports": {
    "@cutout/jsx": "jsr:@cutout/jsx",
    "@cutout/store": "jsr:@cutout/store",
    "@std/fmt": "jsr:@std/fmt",
    "roadroller": "npm:roadroller",
    "~common": "./libraries/common.ts",
    "~projections": "./libraries/projections/module.js",
    "~graphics": "./libraries/graphics/module.js",
    "~objects": "./libraries/objects/module.ts",
    "~audio": "./libraries/audio/module.js"
  }
}
