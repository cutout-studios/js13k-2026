{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@cutout/jsx"
  },
  "imports": {
    "@cutout/jsx": "jsr:@cutout/jsx",
    "@std/fmt": "jsr:@std/fmt",
    "~3D": "./libraries/3D/module.ts",
    "~audio": "./libraries/audio/module.ts",
    "~clock": "./libraries/clock.ts",
    "~common": "./libraries/common.ts",
    "~alias": "./libraries/alias.ts",
    "~envelope": "./libraries/envelope.ts",
    "esbuild": "npm:esbuild",
    "esbuild-minify-templates": "npm:esbuild-minify-templates",
    "roadroller": "npm:roadroller"
  },
  "tasks": {
    "bundle": "deno run --unstable-bundle --allow-write --allow-read --allow-run --allow-env --watch=app,libraries ./scripts/bundle.tsx",
    "clean": "rm -rf .output",
    "setup": "bash ./scripts/setup.sh",
    "test:item": "deno run scripts/drawItem.js",
    "test:level": "deno run scripts/drawLevel.js"
  }
}
