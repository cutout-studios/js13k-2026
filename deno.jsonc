{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@cutout/jsx"
  },
  "imports": {
    "@cutout/jsx": "jsr:@cutout/jsx",
    "@cutout/store": "jsr:@cutout/store",
    "@std/fmt": "jsr:@std/fmt",
    "~audio": "./libraries/audio/module.ts",
    "~clock": "./libraries/clock.ts",
    "~common": "./libraries/common.ts",
    "~controller": "./libraries/controller.ts",
    "~objects": "./libraries/objects/module.ts",
    "~transforms": "./libraries/transforms/module.ts",
    "~viewport": "./libraries/viewport/module.ts",
    "~web": "./libraries/web.ts",
    "roadroller": "npm:roadroller"
  },
  "tasks": {
    "bundle": "deno run --unstable-bundle --allow-write --allow-read --allow-run --watch=app,libraries ./scripts/bundle.tsx",
    "clean": "rm -rf .output",
    "open": "open .output/index.html",
    "setup": "brew bundle"
  }
}
